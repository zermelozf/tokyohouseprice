# Project-local configuration for the SUUMO scraper and its daily report.
#
#   cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored; this example file is not, so never put real
# credentials here. Anything already set in the real environment wins over
# this file, so a cron line or `FOO=bar python -m scraper …` still overrides it.
#
# Verify the mail setup without sending anything:
#   python -m scraper daily-report --check

# --- daily report email ----------------------------------------------------
# Comma-separated for several recipients.
REPORT_TO_EMAIL=arnaud.rachez@gmail.com,ms.estelle.dumas@gmail.com
# Must be verified in SES eu-west-1 (datakokoro.com is NOT).
REPORT_FROM_EMAIL=contact@linalgo.com

# "ses"  -> SES API via boto3   (needs AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY)
# "smtp" -> SES SMTP endpoint   (needs SMTP_USER + SMTP_PASSWORD)
# An SES SMTP password is derived from an IAM secret key — they are different
# strings, so use whichever credential you actually hold.
REPORT_TRANSPORT=ses

# Target of the clickable map in the email.
REPORT_DASHBOARD_URL=http://stellar-dev/tokyohouseprice/scraper

# --- AWS (SES lives in eu-west-1: the same account datakokoro sends from) ---
AWS_SES_REGION_NAME=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only for REPORT_TRANSPORT=smtp.
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=465

# --- scraping --------------------------------------------------------------
# SUUMO_DATA_DIR=scraper/data
# SUUMO_FETCH_PROVIDER=direct
# ZENROWS_API_KEY=
